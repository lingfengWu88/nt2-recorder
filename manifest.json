{
  "manifest_version": 3,
  "name": "NT2 本地分题录制",
  "version": "0.1.2",
  "minimum_chrome_version": "116",
  "description": "录制你主动选择的 NT2 题目标签页；定时分段、本地保存。",
  "permissions": ["activeTab", "scripting", "tabCapture", "offscreen", "downloads", "storage"],
  "action": {"default_popup": "popup.html"},
  "background": {"service_worker": "worker.js"}
}
